		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    ЗатратыОбороты.Участок КАК Участок,
    ЗатратыОбороты.Статья КАК Статья,
    СУММА(ВЫБОР КОГДА ЗатратыОбороты.Тип = "План" ТОГДА ЗатратыОбороты.СуммаОборот ИНАЧЕ 0 КОНЕЦ) КАК ВсегоПлан,
    СУММА(ВЫБОР КОГДА ЗатратыОбороты.Тип = "Факт" ТОГДА ЗатратыОбороты.СуммаОборот ИНАЧЕ 0 КОНЕЦ) КАК ВсегоФакт
ИЗ
    РегистрНакопления.Затраты.Обороты КАК ЗатратыОбороты
СГРУППИРОВАТЬ ПО
    ЗатратыОбороты.Участок,
    ЗатратыОбороты.Статья</query>
	</dataSet>
