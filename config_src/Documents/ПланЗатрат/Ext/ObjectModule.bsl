Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Очищаем старые движения при перепроведении
	Движения.Затраты.Записывать = Истина;
	
	// Проходим по каждой строке табличной части "Затраты"
	Для Каждого ТекСтрока Из Затраты Цикл
		
		Движение = Движения.Затраты.Добавить();
		Движение.Период = Период; // Берем период из шапки документа
		Движение.Участок = Участок;
		Движение.Статья = ТекСтрока.Статья;
		Движение.Тип = "План"; // Указываем тип, чтобы отличать от факта
		Движение.Сумма = ТекСтрока.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры