Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Включаем запись движений
	Движения.ВыпускПродукции.Записывать = Истина;
	
	// Проходим по каждой строке табличной части "Продукция"
	Для Каждого ТекСтрока Из Продукция Цикл
		
		Движение = Движения.ВыпускПродукции.Добавить();
		
		// Заполняем измерения
		Движение.Период = Дата;
		Движение.Участок = Участок;
		Движение.Номенклатура = ТекСтрока.Номенклатура;
		Движение.Склад = ТекСтрока.Склад;
		
		// Заполняем ресурсы
		Движение.Количество = ТекСтрока.Количество;
		Движение.Сумма = ТекСтрока.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры