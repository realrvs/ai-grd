# ==========================================
# .gitignore для проекта 1С (Управление затратами)
# ==========================================

# --- Базы данных 1С (не коммитим саму базу) ---
/db/CostManagementBase/
*.dt
*.cf
*.cfe

# --- Служебные и временные файлы 1С ---
*.log
*.tmp
*.lock
*.cfl
*.mdo
*.old

# --- Кэш и настройки клиента ---
/1Cv8Log/
/1Cv8Log/
*.mdc
*.md

# --- Системные файлы ОС и IDE ---
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# --- Примечание ---
# *.epf и *.erf НЕ исключаются, чтобы внешние обработки попадали в репозиторий.
